{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vpremises://contracts/mounted-sharepoint-report-request/v1",
  "title": "vPremises mounted SharePoint report acquisition request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","request_id","correlation_id","artifact_id","expected_report","allowlisted_root","relative_file","max_bytes"],
  "properties": {
    "schema": {
      "const": "vpremises://contracts/mounted-sharepoint-report-request/v1"
    },
    "request_id": {
      "$ref": "#/$defs/identifier"
    },
    "correlation_id": {
      "$ref": "#/$defs/identifier"
    },
    "artifact_id": {
      "$ref": "#/$defs/identifier"
    },
    "expected_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_mode","reporting_date","headquarters_id","department_id","reporting_team_id","owner_account_id","classification","customer_data"],
      "properties": {
        "record_mode": {
          "enum": ["simulation-seed","runtime","imported"]
        },
        "reporting_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "headquarters_id": {
          "$ref": "#/$defs/identifier"
        },
        "department_id": {
          "$ref": "#/$defs/identifier"
        },
        "reporting_team_id": {
          "$ref": "#/$defs/identifier"
        },
        "owner_account_id": {
          "$ref": "#/$defs/identifier"
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "customer_data": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "customer_data": {
                "const": true
              }
            },
            "required": ["customer_data"]
          },
          "then": {
            "properties": {
              "classification": {
                "const": "customer-confidential"
              }
            }
          }
        }
      ]
    },
    "allowlisted_root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id","base","relative_path"],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "base": {
          "enum": ["workspace-root","request-directory"]
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^/]"
        }
      }
    },
    "relative_file": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^/].*\\.json$"
    },
    "max_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4194304
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "classification": {
      "enum": ["internal","internal-confidential","personal-confidential","restricted-sensitive","customer-confidential"]
    }
  }
}
