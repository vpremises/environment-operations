{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vpremises.example/schemas/vpremises.observer.v1.schema.json",
  "title": "vPremises observer configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "roots",
    "limits",
    "policy"
  ],
  "properties": {
    "schema_version": {
      "const": "vpremises.observer/v1"
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "anyOf": [
              {
                "pattern": "^/"
              },
              {
                "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+){0,15}$"
              }
            ]
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_depth",
        "max_entries",
        "max_total_bytes"
      ],
      "properties": {
        "max_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "max_entries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "max_total_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000000000
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata_only",
        "follow_symlinks"
      ],
      "properties": {
        "metadata_only": {
          "const": true
        },
        "follow_symlinks": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9._-]+$"
    }
  }
}
