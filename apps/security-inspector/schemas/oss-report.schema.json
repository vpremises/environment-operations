{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OSS gate receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "gate",
    "status",
    "findings",
    "uninspected",
    "evidence_sha256",
    "external_actions"
  ],
  "properties": {
    "schema": {
      "const": "vpremises-security/oss-report/v1"
    },
    "gate": {
      "enum": [
        "repository",
        "exclusions",
        "public-package"
      ]
    },
    "status": {
      "enum": [
        "passed",
        "findings",
        "incomplete"
      ]
    },
    "findings": {
      "$ref": "#/$defs/findings"
    },
    "uninspected": {
      "$ref": "#/$defs/findings"
    },
    "evidence_sha256": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "external_actions": {
      "const": false
    }
  },
  "$defs": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "location"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string"
          }
        }
      }
    }
  }
}
