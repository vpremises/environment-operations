{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entries_examined",
    "directories",
    "files",
    "symlinks_skipped",
    "other_entries",
    "total_file_bytes",
    "max_depth_reached"
  ],
  "properties": {
    "entries_examined": {
      "type": "integer",
      "minimum": 0
    },
    "directories": {
      "type": "integer",
      "minimum": 0
    },
    "files": {
      "type": "integer",
      "minimum": 0
    },
    "symlinks_skipped": {
      "type": "integer",
      "minimum": 0
    },
    "other_entries": {
      "type": "integer",
      "minimum": 0
    },
    "total_file_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "max_depth_reached": {
      "type": "integer",
      "minimum": 0
    }
  }
}
