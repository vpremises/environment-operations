{
  "repository": "vpremises/environment-operations",
  "purpose": "Product CLI, credential playground and native helper composition over Crowsi",
  "responsibility_boundary": "Own the named environment configuration/planning or application deployment composition. Generic security and provider mechanisms reuse their managed owners; real profiles/secrets and actual environment activation are separate.",
  "packages": [
    {
      "manifest": "apps/environment-plan/Cargo.toml",
      "package": "vpremises-environment-plan",
      "ecosystem": "rust",
      "description": "Operator CLI for validated environment plans and provider configuration rendering",
      "interfaces": {
        "lib": null,
        "features": {},
        "bins": [],
        "implicit_bins": [
          "apps/environment-plan/src/bin/incus-renderer.rs"
        ]
      },
      "declared_commands": {}
    },
    {
      "manifest": "apps/security-inspector/Cargo.toml",
      "package": "vpremises-security",
      "ecosystem": "rust",
      "description": "Local endpoint monitoring and security reporting tool",
      "interfaces": {
        "lib": "apps/security-inspector/src/lib.rs",
        "features": {},
        "bins": [
          {
            "name": "vpremises-security",
            "path": "src/main.rs"
          }
        ],
        "public_modules": [
          "oss"
        ],
        "public_reexports": [
          "audit::{\n    audit, initialize_bundle, load_audit_config, read_local_document, AuditConfig,\n    BoundaryCollector, Collectors, ContentCollector, NetworkCollector, Tool,\n}",
          "security::{security_report, CheckCoverage, SecurityReport}",
          "execution::{\n    ExecutionContractError, ExecutionControlKindV1, ExecutionControlRequestV1,\n    ExecutionLeaseRequestV1, ExecutionLeaseV1, ExecutionOutcomeV1, ExecutionPlacementV1,\n    ExecutionResultV1, ExecutionStateV1, ProjectionReferenceV1, ValidateExecution,\n}",
          "model::{\n    AllowedRoot, Diagnostic, ExpectedDepartmentDailyReport, MountedSharePointReportReceipt,\n    MountedSharePointReportRequest, ObservationLimits, ObservationPolicy, ObservationReport,\n    ObservationTotals, ObserverConfig, ReportAcquisitionError, ReportAllowedRoot,\n    ReportClassification, ReportRecordMode, ReportRootBase, ReportedPolicy, RootObservation,\n}",
          "observer::observe",
          "report::acquire as acquire_mounted_sharepoint_report"
        ],
        "implicit_bins": []
      },
      "declared_commands": {}
    },
    {
      "manifest": "native/windows-custody-helper/Cargo.toml",
      "package": "vpremises-windows-custody-helper",
      "ecosystem": "rust",
      "description": "Native Windows CurrentUser credential custody helper",
      "interfaces": {
        "lib": null,
        "features": {},
        "bins": [],
        "implicit_bins": []
      },
      "declared_commands": {}
    },
    {
      "manifest": "playground/credential-operations/Cargo.toml",
      "package": "vpremises-credential-examples",
      "ecosystem": "rust",
      "description": "Explicit synthetic credential examples and fail-closed CLI boundary checks",
      "interfaces": {
        "lib": null,
        "features": {},
        "bins": [],
        "implicit_bins": [
          "playground/credential-operations/src/bin/crowsi-credential-demo.rs",
          "playground/credential-operations/src/bin/crowsi-credential.rs"
        ]
      },
      "declared_commands": {}
    }
  ],
