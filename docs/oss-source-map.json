            {
              "name": "Build helper and test synthetic runner credentials",
              "run": "$ErrorActionPreference = 'Stop'\nrustup toolchain install 1.97 --profile minimal\nif ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }\ncargo +1.97 build --locked --release -p vpremises-windows-custody-helper --target x86_64-pc-windows-msvc\nif ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }\n$env:CROWSI_WINDOWS_CUSTODY_PROVIDER_EXECUTABLE = (Resolve-Path target/x86_64-pc-windows-msvc/release/vpremises-windows-custody-helper.exe).Path\n$sdkRevision = python -c \"import tomllib; d=tomllib.load(open('native/windows-custody-helper/Cargo.toml','rb'))['dependencies']['crowsi-windows-custody-provider']; assert d['git']=='https://github.com/crowsi-net/credential-custody.git'; print(d['rev'])\"\nif ($LASTEXITCODE -ne 0 -or $sdkRevision -notmatch '^[a-f0-9]{40}$') { exit 1 }\n$sdkCheckout = Join-Path $env:RUNNER_TEMP 'reviewed-credential-sdk'\ngit init -q $sdkCheckout\ngit -C $sdkCheckout fetch -q --depth 1 https://github.com/crowsi-net/credential-custody.git $sdkRevision\nif ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }\ngit -C $sdkCheckout checkout -q --detach FETCH_HEAD\nif ((git -C $sdkCheckout rev-parse HEAD) -ne $sdkRevision) { exit 1 }\nPush-Location $sdkCheckout\ntry {\n  cargo +1.97 test --locked -p crowsi-windows-custody-provider --test helper-identity\n  if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }\n  cargo +1.97 test --locked -p crowsi-windows-custody-provider --test windows-dpapi-live -- --ignored\n  if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }\n} finally { Pop-Location }\nNew-Item -ItemType Directory -Force dist | Out-Null\nCopy-Item $env:CROWSI_WINDOWS_CUSTODY_PROVIDER_EXECUTABLE,LICENSE,NOTICE dist\n& ./scripts/dependency-notices.ps1\nCompress-Archive -Path dist/* -DestinationPath windows-custody.zip\npython scripts/windows-release-manifest.py create --archive windows-custody.zip --binary dist/vpremises-windows-custody-helper.exe --source-sha $env:GITHUB_SHA --manifest windows-custody-manifest.json\nif ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }\npython scripts/windows-release-manifest.py verify --archive windows-custody.zip --source-sha $env:GITHUB_SHA --manifest windows-custody-manifest.json\nif ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }\n",
